# Copy to api/.env on the server and fill in. Never commit the real file.

# --- Hosts ---
SITE_HOST=irongrip.uk
API_HOST=api.irongrip.uk
ADMIN_HOST=admin.irongrip.uk
ACME_EMAIL=hello@irongrip.uk

# --- Saleor ---
SALEOR_VERSION=3.23
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_USER=saleor
POSTGRES_PASSWORD=change-me
ALLOWED_HOSTS=api.irongrip.uk,api
ALLOWED_CLIENT_HOSTS=irongrip.uk,www.irongrip.uk,admin.irongrip.uk
PUBLIC_URL=https://api.irongrip.uk/
DASHBOARD_URL=https://admin.irongrip.uk/
DEFAULT_CHANNEL_SLUG=uk
DEFAULT_FROM_EMAIL=noreply@irongrip.uk
# EMAIL_URL=smtp://user:pass@smtp.provider:587/?tls=True
HTTP_IP_FILTER_ENABLED=True
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=False

# --- Dashboard extra protection (Caddy basic auth) ---
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_HASH=

# --- Website forms ---
# Notifications are optional; submissions are always stored in the `forms` database.
SMTP_URL=
FORMS_NOTIFY_EMAIL=hello@irongrip.uk
FORMS_TRADE_EMAIL=trade@irongrip.uk
FORMS_FROM_EMAIL=IronGrip website <website@irongrip.uk>

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Leave empty to disable the widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
